# Local development (SQLite)
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Production (Vercel) — SQLite does NOT work on Vercel.
# Use a hosted database instead, e.g. Turso, Neon, or Vercel Postgres:
# DATABASE_URL="libsql://your-db.turso.io?authToken=..."
# AUTH_URL="https://your-app.vercel.app"

# From Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
